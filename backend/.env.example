# PostgreSQL (users + encrypted notes). Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgre_redsand"
# Backend uses PostgreSQL schema "redsand" (see prisma/schema.prisma).
# Indexer tables stay in "public" — do not point both at the same schema.

JWT_SECRET="change-me-redsand-hackathon-secret"
JWT_TTL_HOURS=72
PORT=4020
HOST=0.0.0.0
# Frontend origin — no trailing slash (must match browser Origin exactly)
CORS_ORIGIN=https://red-sand-chi.vercel.app

# Privy (verify Twitter OAuth on link). Keep secret server-side only.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
