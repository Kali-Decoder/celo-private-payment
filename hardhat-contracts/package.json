{
  "name": "@redsand/contracts",
  "private": true,
  "version": "0.1.0",
  "description": "Redsand ZK vault — deposits + claim NFTs on Celo Sepolia (Option B Poseidon Merkle)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "clean": "hardhat clean",
    "deploy": "hardhat run scripts/deploy/deploy-all.ts --network celoSepolia",
    "deploy:all": "hardhat run scripts/deploy/deploy-all.ts --network celoSepolia",
    "deploy:celo": "hardhat run scripts/deploy/deploy-all.ts --network celoSepolia",
    "deploy:local": "hardhat run scripts/deploy/deploy-all.ts --network localhost",
    "deploy:token": "hardhat run scripts/deploy/deploy-token.ts --network celoSepolia",
    "set:token": "hardhat run scripts/deploy/set-token.ts --network celoSepolia",
    "mint:token": "hardhat run scripts/deploy/mint-token.ts --network celoSepolia",
    "mint:all": "hardhat run scripts/deploy/mint-all-tokens.ts --network celoSepolia",
    "smoke": "hardhat run scripts/deploy/smoke.ts --network celoSepolia",
    "post:root": "hardhat run scripts/ops/post-root.ts --network celoSepolia",
    "pool:pause": "ACTION=pause hardhat run scripts/ops/pause.ts --network celoSepolia",
    "pool:unpause": "ACTION=unpause hardhat run scripts/ops/pause.ts --network celoSepolia",
    "vault:pause": "ACTION=pause hardhat run scripts/ops/pause.ts --network celoSepolia",
    "vault:unpause": "ACTION=unpause hardhat run scripts/ops/pause.ts --network celoSepolia",
    "status": "hardhat run scripts/ops/status.ts --network celoSepolia",
    "e2e": "hardhat run test/e2e-flow.ts --network celoSepolia",
    "verify": "hardhat verify --network celoSepolia",
    "verify:all": "hardhat run scripts/deploy/verify-all.ts --network celoSepolia",
    "zk:install": "pnpm --dir ../zk install --ignore-workspace",
    "zk:build": "pnpm --dir ../zk run build",
    "sdk:install": "pnpm --dir ../sdk install --ignore-workspace",
    "sdk:build": "pnpm --dir ../sdk run build",
    "sdk:test": "pnpm --dir ../sdk run test",
    "indexer:install": "pnpm --dir ../indexer install --ignore-workspace",
    "indexer:dev": "pnpm --dir ../indexer dev",
    "indexer:migrate": "pnpm --dir ../indexer db:migrate",
    "indexer:test": "pnpm --dir ../indexer exec node --import tsx --test src/**/*.test.ts",
    "backend:install": "pnpm --dir ../backend install --ignore-workspace",
    "backend:dev": "pnpm --dir ../backend dev",
    "backend:db": "pnpm --dir ../backend db:generate && pnpm --dir ../backend db:push"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.21",
    "chai": "^4.5.0",
    "dotenv": "^16.0.0",
    "ethers": "^6.14.0",
    "hardhat": "^2.28.4",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  }
}
