# Redsand Indexer · Celo Sepolia (chainId 11142220)
# Addresses from ../hardhat-contracts/deployments/celoSepolia.json

RPC_URL=https://forno.celo-sepolia.celo-testnet.org/
CHAIN_ID=11142220

VAULT_ADDRESS=0x71d91e48b88DaEb94A6E14c34e791150a994BA5F
MERKLE_ROOT_MANAGER_ADDRESS=0x90Dfd581393104EAe03Fd349b4867A7E8F51313b

# Dedicated root-poster key — must own MerkleRootManager. NEVER a user key.
RELAYER_PRIVATE_KEY=

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/redsand_indexer

# Use rpc until a Goldsky subgraph indexes the Celo Vault
EVENT_SOURCE=rpc
GOLDSKY_VAULT_URL=
GOLDSKY_ROOT_MANAGER_URL=

CONFIRMATIONS=8
POLL_INTERVAL_MS=4000
START_BLOCK=0
TREE_DEPTH=20
API_PORT=4010
# On Render, PORT is injected automatically and takes precedence over API_PORT.
CORS_ORIGIN=http://localhost:3000

SKIP_POST_ROOT=0
